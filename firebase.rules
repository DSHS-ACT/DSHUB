rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 프로필: role/disabled 필드는 클라이언트가 직접 바꿀 수 없음.
    // 관리자 승격은 반드시 claimAdmin Cloud Function(Admin SDK, 규칙 영향 안 받음)을 거쳐야 함.
    match /userProfiles/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == "student"
        && request.resource.data.disabled != true;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.disabled == resource.data.disabled;
      allow delete: if false;
    }

    // claimAdmin 함수의 무차별 대입 방지용 내부 상태. 클라이언트 접근 전면 차단(Admin SDK만 사용).
    match /_adminSetupAttempts/{uid} {
      allow read, write: if false;
    }

    // 기존 컬렉션들: 기존 동작을 그대로 유지 (별도 감사 전까지 개방 상태).
    // 이 프로젝트는 원래 아래 catch-all 규칙으로 모든 컬렉션이 열려 있었으나,
    // userProfiles의 role/disabled를 잠그기 위해 컬렉션별로 명시했습니다.
    // ⚠️ 아래 컬렉션들은 여전히 인증 여부와 무관하게 전체 read/write가 허용됩니다.
    match /reservations/{document=**} {
      allow read, write: if request.time < timestamp.date(2099, 12, 4);
    }
    match /notices/{document=**} {
      allow read, write: if request.time < timestamp.date(2099, 12, 4);
    }
    match /places/{document=**} {
      allow read, write: if request.time < timestamp.date(2099, 12, 4);
    }
    match /inquiries/{document=**} {
      allow read, write: if request.time < timestamp.date(2099, 12, 4);
    }
  }
}
